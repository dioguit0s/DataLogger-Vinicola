@model List<Vinicola_app.Models.WineryViewModel>

@{
    ViewData["Title"] = "Gerenciar Vinícolas";
}

<style>
    /* Estilo Específico da Página inspirado no VinoSense */
    .header-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 15px;
    }

    /* Card de Vinícola adaptado para parecer com o KPI Card */
    .winery-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px; /* Mesmo raio do dashboard */
        box-shadow: var(--shadow); /* Mesma sombra do dashboard */
        border-left: 5px solid var(--primary-color);
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        transition: transform 0.2s;
    }

        .winery-card:hover {
            transform: translateY(-3px);
        }

    .winery-content {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        flex: 1;
        min-width: 300px;
    }

    .icon-container {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fce4ec; /* Um fundo bem claro vinho/rosa */
        border-radius: 50%;
        color: var(--primary-color);
        font-size: 24px;
        flex-shrink: 0;
    }

        .icon-container img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

    .info-group h4 {
        color: var(--text-dark);
        font-weight: 700;
        margin-bottom: 5px;
        font-size: 1.2rem;
    }

    .info-group .meta {
        color: #888;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .info-group .desc {
        color: #555;
        font-style: italic;
        margin-bottom: 10px;
        font-size: 0.95rem;
    }

    /* Tags estilizadas */
    .contact-tag {
        display: inline-block;
        font-size: 0.8rem;
        padding: 5px 10px;
        border-radius: 6px;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        color: var(--text-dark);
        margin-right: 5px;
        font-weight: 500;
    }

        .contact-tag i {
            color: var(--primary-color);
            margin-right: 4px;
        }

    .card-actions {
        display: flex;
        gap: 10px;
    }

    /* Botão de exclusão mais discreto */
    .btn-delete-custom {
        padding: 8px 15px;
        background-color: white;
        border: 1px solid #dc3545;
        color: #dc3545;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-delete-custom:hover {
            background-color: #dc3545;
            color: white;
        }

    .btn-edit-custom {
        padding: 8px 15px;
        background-color: white;
        border: 1px solid #6c757d;
        color: #6c757d;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-edit-custom:hover {
            background-color: #6c757d;
            color: white;
        }

</style>

<div class="header-actions">
    <h2 class="section-title" style="margin-bottom:0;">@ViewData["Title"]</h2>

    <a asp-action="Create" class="btn btn-primary btn-lg" style="padding: 10px 25px; border-radius: 6px;">
        + Nova Vinícola
    </a>
</div>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger" style="border-radius: 12px; box-shadow: var(--shadow); border:none;">
        @TempData["Erro"]
    </div>
}

<div>
    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5" style="background: white; border-radius: 12px; box-shadow: var(--shadow);">
            <h4 style="color: var(--text-dark);">Nenhuma vinícola cadastrada.</h4>
            <p class="text-muted">Comece adicionando sua primeira unidade no botão acima.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="winery-card">
                <div class="winery-content">
                    <div class="icon-container">
                        @if (!string.IsNullOrEmpty(item.LogoPic))
                        {
                            <img src="@item.LogoPic" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                            <span style="display:none;">🍇</span>
                        }
                        else
                        {
                            <span>🍇</span>
                        }
                    </div>

                    <div class="info-group">
                        <h4>@item.Name</h4>
                        <span class="meta">CNPJ: @item.Cnpj</span>

                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="desc">"@item.Description"</p>
                        }

                        <div style="margin-top: 10px;">
                            <span class="contact-tag">📍 @item.Address</span>

                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <span class="contact-tag">✉️ @item.Email</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Telephone))
                            {
                                <span class="contact-tag">📞 @item.Telephone</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit-custom">
                        Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-delete-custom"
                       onclick="return confirm('Tem certeza que deseja excluir @item.Name? Isso removerá os sensores associados!');">
                        Excluir
                    </a>
                </div>
            </div>
        }
    }
</div>