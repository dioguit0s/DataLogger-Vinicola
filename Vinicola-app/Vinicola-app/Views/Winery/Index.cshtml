@model List<Vinicola_app.Models.WineryViewModel>

@{
    ViewData["Title"] = "Minhas Vinícolas";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h2 {
            color: #2c3e50;
            font-weight: 700;
            margin: 0;
        }

    /* Card específico para Vinícola (Adaptado) */
    .winery-card {
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        /* Cor Vinho/Roxo para diferenciar dos Loggers */
        border-left: 5px solid #8e44ad;
        padding: 20px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        transition: box-shadow 0.3s ease;
    }

        .winery-card:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .winery-info {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        flex: 1;
        min-width: 250px;
    }

        .winery-info .icon {
            font-size: 36px;
            color: #8e44ad; /* Cor do ícone */
            padding-top: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
        }

        .winery-info .logo-img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #eee;
        }

    .winery-details h4 {
        margin: 0 0 5px 0;
        color: #2c3e50;
        font-size: 1.25rem;
        font-weight: bold;
    }

    .winery-details .meta-info {
        color: #7f8c8d;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
    }

    .winery-details .description {
        font-style: italic;
        color: #555;
        font-size: 0.9rem;
        margin-bottom: 10px;
    }

    /* Badges para contatos */
    .badge-contato {
        display: inline-block;
        font-size: 0.8rem;
        padding: 4px 8px;
        border-radius: 4px;
        margin-right: 5px;
        margin-bottom: 5px;
        background-color: #f3e5f5; /* Fundo levemente roxo */
        border: 1px solid #e1bee7;
        color: #4a148c;
    }

    .winery-actions {
        display: flex;
        gap: 10px;
    }
</style>

<div class="page-header">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary btn-lg" style="background-color: #8e44ad; border-color: #8e44ad;">
        🍷 Nova Vinícola
    </a>
</div>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">
        @TempData["Erro"]
    </div>
}

<div>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Nenhuma vinícola cadastrada. Clique no botão acima para adicionar sua primeira propriedade.
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="winery-card">
                <div class="winery-info">
                    <div class="icon">
                        @if (!string.IsNullOrEmpty(item.LogoPic))
                        {
                            <img src="@item.LogoPic" alt="Logo" class="logo-img" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                            <span style="display:none;">🍇</span>
                        }
                        else
                        {
                            <span>🍇</span>
                        }
                    </div>

                    <div class="winery-details">
                        <h4>@item.Name</h4>

                        <span class="meta-info">CNPJ: @item.Cnpj</span>

                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="description">"@item.Description"</p>
                        }

                        <p class="mb-2"><small>📍 @item.Address</small></p>

                        <div>
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <span class="badge-contato" title="Email">
                                    📧 @item.Email
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(item.Telephone))
                            {
                                <span class="badge-contato" title="Telefone">
                                    📞 @item.Telephone
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="winery-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info text-white">
                        Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"
                       onclick="return confirm('Tem certeza que deseja excluir a vinícola @item.Name? Isso excluirá também os sensores vinculados!');">
                        Excluir
                    </a>
                </div>
            </div>
        }
    }
</div>