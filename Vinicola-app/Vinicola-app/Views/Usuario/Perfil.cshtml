@model Vinicola_app.Models.UsuarioViewModel

@{
    ViewData["Title"] = "Meu Perfil";
    // Define imagem padrão ou converte do banco
    string imagemSrc = "https://via.placeholder.com/150/800020/FFFFFF?text=Usuario";
    if (Model.FotoProfile != null && Model.FotoProfile.Length > 0)
    {
        string base64 = Convert.ToBase64String(Model.FotoProfile);
        imagemSrc = String.Format("data:image/jpeg;base64,{0}", base64);
    }
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm" style="border-radius: 12px; border-top: 5px solid var(--primary-color);">
            <div class="card-body p-4">

                <h3 class="mb-4" style="color: var(--primary-color); font-weight: 700;">
                    <i class="fas fa-user-circle me-2"></i> Editar Perfil
                </h3>

                @if (TempData["Sucesso"] != null)
                {
                    <div class="alert alert-success">@TempData["Sucesso"]</div>
                }
                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger">@TempData["Erro"]</div>
                }

                <form asp-action="SalvarPerfil" asp-controller="Usuario" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="SenhaHash" />

                    <div class="row align-items-center mb-4">
                        <div class="col-md-4 text-center">
                            <div style="width: 150px; height: 150px; margin: 0 auto; border-radius: 50%; overflow: hidden; border: 4px solid var(--secondary-color); box-shadow: var(--shadow);">
                                <img src="@imagemSrc" class="img-preview-perfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                            <div class="mt-3">
                                <label for="FotoUpload" class="btn btn-sm btn-outline-secondary" style="cursor: pointer;">
                                    📷 Alterar Foto
                                </label>
                                <input asp-for="FotoUpload" type="file" id="FotoUpload" class="d-none" accept="image/*" onchange="previewImagem(this)" />
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="Nome" class="form-label fw-bold">Nome Completo</label>
                                <input asp-for="Nome" class="form-control" />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success px-4" style="background-color: var(--primary-color); border-color: var(--primary-color);">
                            💾 Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImagem(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                // Seleciona TODOS os elementos com a classe img-preview-perfil e atualiza o src
                var previews = document.getElementsByClassName('img-preview-perfil');
                for (var i = 0; i < previews.length; i++) {
                    previews[i].src = e.target.result;
                }
            }

            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}