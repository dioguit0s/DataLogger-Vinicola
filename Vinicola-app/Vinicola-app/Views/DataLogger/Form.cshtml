@model Vinicola_app.Models.DataLoggerViewModel

@{
    ViewData["Title"] = ViewBag.Operacao == "I" ? "Novo Data Logger" : "Editar Data Logger";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="fas fa-satellite-dish me-2"></i>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">

                @if (ViewBag.Erro != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Erro!</strong> @ViewBag.Erro
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Salvar" method="post">
                    <input type="hidden" name="operacao" value="@ViewBag.Operacao" />
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />

                    <h5 class="text-muted mb-3 border-bottom pb-2">Identificação</h5>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="DeviceId" class="control-label fw-bold">ID do Dispositivo (FIWARE)</label>
                            <input asp-for="DeviceId" class="form-control" placeholder="Ex:001" />
                            <span asp-validation-for="DeviceId" class="text-danger"></span>
                            @if (ViewBag.Operacao == "A")
                            {
                                <small class="text-muted" style="font-size: 0.75rem;">
                                    ⚠️ Alterar este ID não atualiza automaticamente o dispositivo no servidor FIWARE.
                                </small>
                            }
                        </div>

                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="WineryId" class="control-label fw-bold">Vinícola Vinculada</label>
                            <select asp-for="WineryId" asp-items="ViewBag.Vinicolas" class="form-select">
                                <option value="">-- Selecione uma Vinícola --</option>
                            </select>
                            <span asp-validation-for="WineryId" class="text-danger"></span>
                        </div>
                    </div>

                    <h5 class="text-muted mt-4 mb-3 border-bottom pb-2">Configuração de Limites (Alarmes)</h5>

                    <div class="row mb-2">
                        <div class="col-md-12"><label class="text-primary fw-bold">🌡️ Temperatura (°C)</label></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="TempMin" class="control-label">Mínima</label>
                            <input asp-for="TempMin" class="form-control" type="number" step="0.1" />
                            <span asp-validation-for="TempMin" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="TempMax" class="control-label">Máxima</label>
                            <input asp-for="TempMax" class="form-control" type="number" step="0.1" />
                            <span asp-validation-for="TempMax" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-12"><label class="text-info fw-bold">💧 Umidade (%)</label></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="HumidMin" class="control-label">Mínima</label>
                            <input asp-for="HumidMin" class="form-control" type="number" step="1" />
                            <span asp-validation-for="HumidMin" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="HumidMax" class="control-label">Máxima</label>
                            <input asp-for="HumidMax" class="form-control" type="number" step="1" />
                            <span asp-validation-for="HumidMax" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-12"><label class="text-warning fw-bold">💡 Luminosidade (Lux)</label></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="LumMin" class="control-label">Mínima</label>
                            <input asp-for="LumMin" class="form-control" type="number" step="1" />
                            <span asp-validation-for="LumMin" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="LumMax" class="control-label">Máxima</label>
                            <input asp-for="LumMax" class="form-control" type="number" step="1" />
                            <span asp-validation-for="LumMax" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mt-4 d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Voltar
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fas fa-save"></i> Salvar Configurações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}