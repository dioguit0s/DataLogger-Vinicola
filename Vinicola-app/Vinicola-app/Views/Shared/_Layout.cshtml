@{
    // Tenta pegar o nome do usuário, ou usa "Usuário" se estiver vazio
    var nomeUsuario = Context.Session.GetString("UsuarioNome") ?? "Usuário";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VinoSense</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vinicola_app.styles.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #800020; /* Vinho oficial */
            --primary-hover: #5a0016;
            --secondary-color: #f8f9fa; /* Fundo cinza claro */
            --text-dark: #2c3e50;
            --text-light: #fff;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background-color: var(--secondary-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            color: #333;
        }

        /* --- Navbar --- */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 4px solid var(--primary-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            height: 80px;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .navbar-custom .logo {
                display: flex;
                align-items: center;
            }

                .navbar-custom .logo img {
                    max-height: 55px;
                    width: auto;
                }

            .navbar-custom .nav-links {
                display: flex;
                gap: 25px;
                list-style: none;
                margin: 0;
                padding: 0;
            }

                .navbar-custom .nav-links li a {
                    color: var(--text-dark);
                    text-decoration: none;
                    font-weight: 600;
                    font-size: 0.95rem;
                    transition: color 0.3s;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                    .navbar-custom .nav-links li a:hover {
                        color: var(--primary-color);
                    }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-info {
            text-align: right;
        }

        .user-name {
            font-size: 0.9rem;
            font-weight: bold;
            color: var(--primary-color);
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .btn-logout-custom {
            background: transparent;
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            padding: 6px 15px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .btn-logout-custom:hover {
                background-color: var(--primary-color);
                color: white;
            }

        /* --- Main Content --- */
        .main-container {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            flex: 1; /* Empurra o footer para baixo */
        }

        /* --- Overrides --- */
        .section-title {
            margin-bottom: 1.5rem;
            color: var(--text-dark);
            font-weight: 700;
            border-left: 5px solid var(--primary-color);
            padding-left: 15px;
        }

        .btn-primary {
            background-color: var(--text-dark);
            border-color: var(--text-dark);
            font-weight: 600;
        }

            .btn-primary:hover {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

        footer {
            background-color: #fff;
            padding: 15px 0;
            text-align: center;
            border-top: 1px solid #eee;
            margin-top: auto;
            font-size: 0.9rem;
            color: #666;
        }

        @@media (max-width: 768px) {
            .navbar-custom {
                flex-direction: column;
                height: auto;
                padding: 1rem;
                gap: 1rem;
            }

                .navbar-custom .nav-links {
                    flex-wrap: wrap;
                    justify-content: center;
                }
        }
    </style>
</head>
<body>

    <nav class="navbar-custom">
        <div class="logo">
            <a href="@Url.Action("Index", "Home")" style="text-decoration:none;">
                <img src="@Url.Content("~/files/qualivine-logo.png")" alt="VinoSense" onerror="this.style.display='none'; document.getElementById('logo-text').style.display='block';">
                <span id="logo-text" style="display:none; font-weight:bold; color:#800020; font-size:1.5rem;">🍷 VinoSense</span>
            </a>
        </div>

        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">Dashboard</a></li>
            <li><a href="@Url.Action("Index", "Winery")">Vinícolas</a></li>
            <li><a href="@Url.Action("Index", "DataLogger")">DataLoggers</a></li>
            <li><a href="@Url.Action("Sobre", "Home")">Sobre</a></li>
        </ul>

        <div class="user-profile dropdown">
            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle"
               id="userDropdown"
               data-bs-toggle="dropdown"
               aria-expanded="false"
               style="color: inherit;">

                <div class="user-info me-2 text-end d-none d-md-block">
                    <div class="user-name" style="font-size: 0.9rem; font-weight: bold; color: var(--primary-color);">
                        Olá, @nomeUsuario
                    </div>
                    <small style="font-size: 0.75rem; color: #888;">Minha Conta</small>
                </div>

                <div class="avatar" style="width: 45px; height: 45px; border: 2px solid var(--primary-color); border-radius: 50%; overflow: hidden;">
                    @{
                        // Tenta pegar imagem da sessão ou renderiza placeholder
                        var fotoSessao = Context.Session.Get("UsuarioFoto"); // Requer extensão de sessão ou lógica similar
                        string avatarUrl = "https://via.placeholder.com/45/800020/FFFFFF?text=" + nomeUsuario.Substring(0, 1);

                        // Se você não tiver a foto na sessão, pode deixar o placeholder ou fazer uma ViewComponent
                        if (fotoSessao != null && fotoSessao.Length > 0)
                        {
                            avatarUrl = "data:image/jpeg;base64," + Convert.ToBase64String(fotoSessao);
                        }
                    }
                    <img src="@avatarUrl" alt="User" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown" style="border: none; border-top: 3px solid var(--primary-color);">
                <li>
                    <a class="dropdown-item py-2" href="@Url.Action("Perfil", "Usuario")">
                        <i class="fas fa-user-edit me-2" style="color: var(--primary-color);"></i> Editar Perfil
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item py-2 text-danger" href="@Url.Action("Sair", "Login")" onclick="return confirm('Deseja realmente sair?');">
                        <i class="fas fa-sign-out-alt me-2"></i> Sair
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            &copy; 2025 - VinoSense - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>