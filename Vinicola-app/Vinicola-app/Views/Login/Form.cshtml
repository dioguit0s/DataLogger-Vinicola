@model UsuarioViewModel
@{
    ViewBag.Title = "Login";
    Layout = null; /* Geralmente login não usa o layout padrão com menu, mas remova se quiser manter */
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<style>
    body {
        background-color: #f8f9fa; /* Fundo cinza claro para a página */
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
    }

    .login-container {
        width: 100%;
        max-width: 400px; /* Mais estreito que o form de cadastro */
        padding: 40px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .brand-logo {
        text-align: center;
        margin-bottom: 30px;
        color: #2c3e50;
        font-family: 'Georgia', serif; /* Fonte serifada para dar tom de "Vinho" */
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: 1px;
    }

        .brand-logo span {
            color: #800020; /* Um tom vinho (Burgundy) para o "Sense" ou detalhe */
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .control-label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 8px;
        padding: 12px 15px; /* Um pouco mais alto para login */
        border: 1px solid #ced4da;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .btn-block {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .btn-login {
        background-color: #2c3e50;
        color: white;
        border: none;
    }

        .btn-login:hover {
            background-color: #1a252f;
            color: white;
        }

    .divider {
        text-align: center;
        margin: 20px 0;
        border-bottom: 1px solid #e9ecef;
        line-height: 0.1em;
        color: #6c757d;
    }

        .divider span {
            background: #fff;
            padding: 0 10px;
        }
</style>

<div class="login-container">
    <div class="brand-logo">
        Vino<span>Sense</span>
    </div>

    @using (Html.BeginForm("Autenticar", "Login", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-3" })

        <div class="form-group">
            @Html.LabelFor(m => m., new { @class = "control-label" })
            @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "seu@email.com", autofocus = "autofocus" } })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Senha, new { @class = "control-label" })
            @Html.EditorFor(m => m.Senha, new { htmlAttributes = new { @class = "form-control", placeholder = "Sua senha" } })
            @Html.ValidationMessageFor(m => m.Senha, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group mt-4">
            <button type="submit" class="btn btn-login btn-block">Entrar</button>
        </div>
    }

    <div class="divider">
        <span>ou</span>
    </div>

    <a href="@Url.Action("Create", "Usuario")" class="btn btn-outline-secondary btn-block">
        Registrar-se
    </a>
</div>