@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VinoSense - Dashboard</title>

    <style>
        :root {
            /* Cores extraídas do Login */
            --primary-color: #800020; /* Vinho oficial */
            --primary-hover: #5a0016;
            --secondary-color: #f8f9fa; /* Fundo cinza claro */
            --text-dark: #2c3e50;
            --text-light: #fff;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            /* Fonte idêntica ao Login */
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background-color: var(--secondary-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            color: #333;
        }

        /* --- Navbar (Estilo White Card) --- */
        .navbar {
            background-color: #ffffff;
            /* Borda inferior vinho para identidade visual */
            border-bottom: 4px solid var(--primary-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            height: 80px; /* Um pouco mais alta para a logo */
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            display: flex;
            align-items: center;
        }

            .logo img {
                max-height: 55px; /* Tamanho ajustado da logo */
                width: auto;
            }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
            margin: 0;
        }

            .nav-links li a {
                color: var(--text-dark);
                text-decoration: none;
                font-weight: 600;
                font-size: 0.95rem;
                transition: color 0.3s;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

                .nav-links li a:hover {
                    color: var(--primary-color);
                }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-info {
            text-align: right;
        }

        .user-name {
            font-size: 0.9rem;
            font-weight: bold;
            color: var(--primary-color);
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .btn-logout {
            background: transparent;
            /* Botão outline para combinar com fundo branco */
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            padding: 6px 15px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }

            .btn-logout:hover {
                background-color: var(--primary-color);
                color: white;
                text-decoration: none;
            }

            .btn-logout a {
                text-decoration: none;
                color: inherit; /* Herda a cor do botão pai */
            }

        /* --- Main Content --- */
        .main-container {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .section-title {
            margin-bottom: 1.5rem;
            color: var(--text-dark);
            font-weight: 700;
            border-left: 5px solid var(--primary-color);
            padding-left: 15px;
        }

        /* --- Filters Bar --- */
        .filters-bar {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
            display: flex;
            gap: 20px;
            align-items: end;
            flex-wrap: wrap;
            border: 1px solid #eee;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .filter-group label {
                font-size: 0.75rem;
                color: #888;
                font-weight: bold;
                text-transform: uppercase;
            }

            .filter-group select {
                padding: 10px;
                border: 1px solid #ced4da;
                border-radius: 6px;
                min-width: 200px;
                background-color: #fff;
                color: #495057;
                font-size: 0.9rem;
            }

        .btn-filter {
            padding: 10px 25px;
            background-color: var(--text-dark); /* Botão escuro para contraste elegante */
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }

            .btn-filter:hover {
                background-color: var(--primary-color); /* Fica vinho ao passar o mouse */
            }

        /* --- KPI Cards --- */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 2rem;
        }

        .kpi-card {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            border-left: 5px solid var(--primary-color); /* Mantém o padrão */
            transition: transform 0.2s;
        }

            .kpi-card:hover {
                transform: translateY(-3px);
            }

            .kpi-card h3 {
                font-size: 0.85rem;
                color: #6c757d;
                margin-bottom: 10px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .kpi-value {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--text-dark);
        }

        .kpi-status {
            font-size: 0.8rem;
            margin-top: 8px;
            font-weight: 500;
        }

        .status-ok {
            color: #27ae60;
        }

        .status-warn {
            color: #f39c12;
        }

        .status-danger {
            color: #c0392b;
        }

        /* --- Charts Grid --- */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 20px;
        }

        .chart-container {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            position: relative;
            height: 400px;
            width: 100%;
        }

        .chart-full {
            grid-column: 1 / -1;
        }

        /* Responsividade */
        @@media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                height: auto;
                padding: 1rem;
                gap: 1rem;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }

            .logo img {
                max-height: 45px;
            }

            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <nav class="navbar">
        <div class="logo">
            <img src="@Url.Content("~/files/qualivine-logo.png")" alt="Qualivine">
        </div>

        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">Dashboard</a></li>
            <li><a href="@Url.Action("Index", "Winery")">Vinícolas</a></li>
            <li><a href="@Url.Action("Index", "DataLogger")">DataLoggers</a></li>
            <li><a href="@Url.Action("Sobre", "Home")">Sobre</a></li>
        </ul>

        <div class="user-profile">
            <div class="user-info">
                <div class="user-name">Ola, @Context.Session.GetString("UsuarioNome")</div>
            </div>

            <div class="avatar">
                <img src="https://via.placeholder.com/40/800020/FFFFFF?text=User" alt="User">
            </div>

            <a href="@Url.Action("Sair", "Login")" class="btn-logout">
                Sair
            </a>
        </div>
    </nav>

    <div class="main-container">

        <h2 class="section-title">Painel de Monitoramento</h2>

        <div class="filters-bar">
            <div class="filter-group">
                <label for="vinicolaSelect">Vinícola</label>
                <select id="vinicolaSelect">
                    <option value="all">Todas as Vinícolas</option>
                    <option value="1">Vinícola Santa Helena</option>
                    <option value="2">Vinícola Vale Verde</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="sensorSelect">Datalogger</label>
                <select id="sensorSelect">
                    <option value="all">Todos os Sensores</option>
                    <option value="DL-01">DL-01 (Adega Principal)</option>
                    <option value="DL-02">DL-02 (Armazenamento)</option>
                    <option value="DL-03">DL-03 (Fermentação)</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="periodoSelect">Período de Análise</label>
                <select id="periodoSelect">
                    <option value="hour">Última Hora (Tempo Real)</option>
                    <option value="day" selected>Últimas 24 Horas</option>
                    <option value="week">Últimos 7 Dias</option>
                </select>
            </div>

            <button class="btn-filter" onclick="updateDashboard()">Atualizar Dados</button>
        </div>

        <div class="kpi-grid">
            <div class="kpi-card" style="border-left-color: #800020;">
                <h3>Temperatura Média</h3>
                <div class="kpi-value">-- °C</div>
                <div class="kpi-status status-ok">Aguardando dados...</div>
            </div>
            <div class="kpi-card" style="border-left-color: #2c3e50;">
                <h3>Umidade Relativa</h3>
                <div class="kpi-value">-- %</div>
                <div class="kpi-status status-warn">Aguardando dados...</div>
            </div>
            <div class="kpi-card" style="border-left-color: #f39c12;">
                <h3>Luminosidade</h3>
                <div class="kpi-value">-- Lux</div>
                <div class="kpi-status status-ok">Aguardando dados...</div>
            </div>
            <div class="kpi-card" style="border-left-color: #27ae60;">
                <h3>Status do Sistema</h3>
                <div class="kpi-value">Online</div>
                <div class="kpi-status status-ok">Conexão com FIWARE OK</div>
            </div>
        </div>

        <div class="charts-grid">
            <div class="chart-container chart-full">
                <canvas id="tempHumidityChart"></canvas>
            </div>

            <div class="chart-container">
                <canvas id="luxChart"></canvas>
            </div>

            <div class="chart-container">
                <canvas id="sensorComparisonChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        // --- FUNÇÕES DE DADOS SIMULADOS (MOCK) ---
        function generateLabels(count) {
            const labels = [];
            const now = new Date();
            for (let i = 0; i < count; i++) {
                const date = new Date(now.getTime() - (i * 60 * 60 * 1000));
                labels.unshift(`${date.getHours()}:00`);
            }
            return labels;
        }

        function generateData(count, min, max) {
            return Array.from({ length: count }, () => Math.floor(Math.random() * (max - min + 1) + min));
        }

        const labels = generateLabels(12);

        // --- CONFIGURAÇÃO CHART.JS ---

        // 1. Gráfico de Temperatura e Umidade (Cores ajustadas para o tema)
        const ctxTempHum = document.getElementById('tempHumidityChart').getContext('2d');
        const tempHumidityChart = new Chart(ctxTempHum, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Temperatura (°C)',
                        data: generateData(12, 12, 16),
                        borderColor: '#800020', // VINHO (Tema)
                        backgroundColor: 'rgba(128, 0, 32, 0.1)',
                        yAxisID: 'y',
                        tension: 0.4,
                        borderWidth: 2,
                        pointRadius: 3
                    },
                    {
                        label: 'Umidade (%)',
                        data: generateData(12, 60, 80),
                        borderColor: '#2c3e50', // Azul Escuro (Tema)
                        backgroundColor: 'rgba(44, 62, 80, 0.1)',
                        yAxisID: 'y1',
                        tension: 0.4,
                        borderWidth: 2,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    title: { display: true, text: 'Histórico de Monitoramento (12h)', font: { size: 16 } },
                    legend: { position: 'top' }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: 'Temperatura (°C)' },
                        grid: { color: '#f0f0f0' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        title: { display: true, text: 'Umidade (%)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Gráfico de Luminosidade
        const ctxLux = document.getElementById('luxChart').getContext('2d');
        const luxChart = new Chart(ctxLux, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Luminosidade (Lux)',
                    data: generateData(12, 100, 500),
                    borderColor: '#f39c12',
                    backgroundColor: 'rgba(243, 156, 18, 0.2)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'Variação de Luminosidade' }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { grid: { color: '#f0f0f0' } }
                }
            }
        });

        // 3. Gráfico Comparativo
        const ctxComp = document.getElementById('sensorComparisonChart').getContext('2d');
        const sensorComparisonChart = new Chart(ctxComp, {
            type: 'bar',
            data: {
                labels: ['DL-01', 'DL-02', 'DL-03'],
                datasets: [{
                    label: 'Temp Média Hoje',
                    data: [14.2, 15.1, 13.8],
                    backgroundColor: [
                        'rgba(128, 0, 32, 0.8)', // Vinho
                        'rgba(44, 62, 80, 0.8)', // Escuro
                        'rgba(243, 156, 18, 0.8)' // Laranja
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'Comparativo entre Sensores' },
                    legend: { display: false }
                },
                scales: {
                    y: { grid: { color: '#f0f0f0' } },
                    x: { grid: { display: false } }
                }
            }
        });

        // --- LÓGICA DE ATUALIZAÇÃO ---
        async function updateDashboard() {
            const deviceId = document.getElementById('sensorSelect').value;
            const btn = document.querySelector('.btn-filter');
            const originalText = btn.innerText;

            btn.innerText = "Carregando...";
            btn.disabled = true;
            btn.style.opacity = "0.7";

            try {
                // Chama Controller C#
                const response = await fetch(`@Url.Action("ObterDadosDashboard", "Home")?deviceId=${deviceId}`);

                if (!response.ok) throw new Error("Falha na requisição");

                const data = await response.json();

                // 1. Atualiza KPI Cards (Seletores por índice)
                const cards = document.querySelectorAll('.kpi-value');
                if(data.kpi) {
                    cards[0].innerText = data.kpi.temp.toFixed(1) + ' °C';
                    cards[1].innerText = data.kpi.hum.toFixed(1) + '%';
                    cards[2].innerText = data.kpi.lum.toFixed(0) + ' Lux';
                }

                // 2. Atualiza Gráfico Temp/Hum
                if(data.charts) {
                    tempHumidityChart.data.datasets[0].data = data.charts.temp || [];
                    tempHumidityChart.data.datasets[1].data = data.charts.hum || [];
                    tempHumidityChart.update();

                    // 3. Atualiza Gráfico Lux
                    luxChart.data.datasets[0].data = data.charts.lum || [];
                    luxChart.update();
                }

                console.log("Dados atualizados do FIWARE:", data);

            } catch (error) {
                console.error("Erro ao buscar dados:", error);
                // alert("Erro ao conectar com o servidor. Verifique o console.");
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
                btn.style.opacity = "1";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            updateDashboard();
        });
    </script>
</body>
</html>