@model Vinicola_app.Models.DashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WineLogger - Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --primary-color: #722F37; /* Cor de Vinho */
            --secondary-color: #f4f4f9;
            --text-dark: #333;
            --text-light: #fff;
            --sidebar-width: 250px;
            --shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Roboto', sans-serif;
        }

        body {
            background-color: var(--secondary-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* --- Navbar --- */
        .navbar {
            background-color: var(--primary-color);
            color: var(--text-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            height: 70px;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            list-style: none;
        }

            .nav-links li a {
                color: var(--text-light);
                text-decoration: none;
                font-weight: 500;
                transition: opacity 0.3s;
            }

                .nav-links li a:hover {
                    opacity: 0.8;
                }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-info {
            text-align: right;
        }

        .user-name {
            font-size: 0.9rem;
            font-weight: bold;
        }

        .user-role {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        .avatar {
            width: 40px;
            height: 40px;
            background-color: #fff;
            border-radius: 50%;
            display: flex; /* Placeholder para imagem */
            align-items: center;
            justify-content: center;
            color: var(--primary-color);
            font-weight: bold;
        }

        .btn-logout {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.5);
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-logout:hover {
                background: rgba(255,255,255,0.1);
            }

        /* --- Main Content --- */
        .main-container {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        /* --- Filters Bar --- */
        .filters-bar {
            background: white;
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
            display: flex;
            gap: 20px;
            align-items: end;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .filter-group label {
                font-size: 0.85rem;
                color: #666;
                font-weight: bold;
            }

            .filter-group select {
                padding: 10px;
                border: 1px solid #ddd;
                border-radius: 5px;
                min-width: 200px;
                background-color: #fff;
            }

        .btn-filter {
            padding: 10px 20px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        /* --- KPI Cards --- */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 2rem;
        }

        .kpi-card {
            background: white;
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: var(--shadow);
            border-left: 5px solid var(--primary-color);
        }

            .kpi-card h3 {
                font-size: 0.9rem;
                color: #666;
                margin-bottom: 10px;
            }

        .kpi-value {
            font-size: 2rem;
            font-weight: bold;
            color: var(--text-dark);
        }

        .kpi-status {
            font-size: 0.8rem;
            margin-top: 5px;
        }

        .status-ok {
            color: green;
        }

        .status-warn {
            color: orange;
        }

        .status-danger {
            color: red;
        }

        /* --- Charts Grid --- */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 20px;
        }

        .chart-container {
            background: white;
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: var(--shadow);
            position: relative;
            height: 400px;
            width: 100%;
        }

        .chart-full {
            grid-column: 1 / -1;
        }

        h2.section-title {
            margin-bottom: 1rem;
            color: var(--primary-color);
        }

        {
            flex-direction: column;
            height: auto;
            padding: 1rem;
            gap: 1rem;
        }

        .nav-links {
            flex-wrap: wrap;
            justify-content: center;
        }

        .charts-grid {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="logo">
            <span>🍷 WineLogger</span>
        </div>
        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("Index", "Winery")">Vinícolas</a></li>
            <li><a href="@Url.Action("Index","DataLogger")">DataLoggers</a></li>
            <li><a href="@Url.Action("Sobre", "Home")">Sobre</a></li>
        </ul>
        <div class="user-profile">
            <div class="user-info">
                <div class="user-name">@Context.Session.GetString("UsuarioNome")</div>
            </div>
            <div class="avatar">
                <img src="https://via.placeholder.com/40" alt="JS" style="border-radius: 50%;">
            </div>
            <button class="btn-logout" onclick="alert('Logout acionado')">
                <a href="@Url.Action("Sair", "Login")">
                    Sair
                </a>
            </button>
        </div>
    </nav>

    <div class="main-container">

        <h2 class="section-title">Painel de Monitoramento</h2>

        <div class="filters-bar">
            <div class="filter-group">
                <label for="vinicolaSelect">Vinícola</label>
                <select id="vinicolaSelect">
                    <option value="all">Todas as Vinícolas</option>
                    @if (Model != null && Model.Vinicolas.Any())
                    {
                        foreach (var winery in Model.Vinicolas)
                        {
                            <option value="@winery.Id">@winery.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="sensorSelect">Datalogger</label>
                <select id="sensorSelect" onchange="updateDashboard()">
                    @if (Model == null || !Model.Loggers.Any())
                    {
                        <option value="">Nenhum sensor cadastrado</option>
                    }
                    else
                    {
                        foreach (var logger in Model.Loggers)
                        {
                            <option value="@logger.DeviceId">
                                @logger.DeviceId
                                @(!string.IsNullOrEmpty(logger.WineryId.ToString()) ? $"(Vinícola #{logger.WineryId})" : "")
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="periodoSelect">Período de Análise</label>
                <select id="periodoSelect">
                    <option value="hour">Última Hora (Tempo Real)</option>
                    <option value="day" selected>Últimas 24 Horas</option>
                    <option value="week">Últimos 7 Dias</option>
                </select>
            </div>
        </div>

        <div class="kpi-grid">
            <div class="kpi-card" style="border-left-color: #ff6384;">
                <h3>Temperatura Média (Atual)</h3>
                <div class="kpi-value">14.5 °C</div>
                <div class="kpi-status status-ok">Dentro do esperado</div>
            </div>
            <div class="kpi-card" style="border-left-color: #36a2eb;">
                <h3>Umidade Relativa (Atual)</h3>
                <div class="kpi-value">72%</div>
                <div class="kpi-status status-warn">Levemente alta</div>
            </div>
            <div class="kpi-card" style="border-left-color: #ffce56;">
                <h3>Luminosidade (Atual)</h3>
                <div class="kpi-value">120 Lux</div>
                <div class="kpi-status status-ok">Ideal</div>
            </div>
            <div class="kpi-card" style="border-left-color: #4bc0c0;">
                <h3>Sensores Ativos</h3>
                <div class="kpi-value">3/3</div>
                <div class="kpi-status status-ok">Conexão estável</div>
            </div>
        </div>

        <div class="charts-grid">
            <div class="chart-container chart-full">
                <canvas id="tempHumidityChart"></canvas>
            </div>

            <div class="chart-container">
                <canvas id="luxChart"></canvas>
            </div>

            <div class="chart-container">
                <canvas id="sensorComparisonChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        // --- MOCK DATA GENERATORS ---
        // Função para gerar horários simulados
        function generateLabels(count) {
            const labels = [];
            const now = new Date();
            for (let i = 0; i < count; i++) {
                const date = new Date(now.getTime() - (i * 60 * 60 * 1000)); // 1 ponto por hora para simplificar o gráfico inicial
                labels.unshift(`${date.getHours()}:00`);
            }
            return labels;
        }

        // Função para gerar dados numéricos aleatórios dentro de um range
        function generateData(count, min, max) {
            return Array.from({ length: count }, () => Math.floor(Math.random() * (max - min + 1) + min));
        }

        const labels = generateLabels(12); // Últimas 12 horas

        // --- CONFIGURAÇÃO CHART.JS ---

        // 1. Gráfico de Temperatura e Umidade (Linha mista)
        const ctxTempHum = document.getElementById('tempHumidityChart').getContext('2d');
        const tempHumidityChart = new Chart(ctxTempHum, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Temperatura (°C)',
                        data: generateData(12, 12, 16), // Entre 12 e 16 graus
                        borderColor: '#ff6384',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        yAxisID: 'y',
                        tension: 0.4
                    },
                    {
                        label: 'Umidade (%)',
                        data: generateData(12, 60, 80), // Entre 60 e 80%
                        borderColor: '#36a2eb',
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        yAxisID: 'y1',
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    title: {
                        display: true,
                        text: 'Histórico de Temperatura e Umidade (Últimas 12h)'
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: 'Temperatura (°C)' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        title: { display: true, text: 'Umidade (%)' }
                    }
                }
            }
        });

        // 2. Gráfico de Luminosidade (Área)
        const ctxLux = document.getElementById('luxChart').getContext('2d');
        const luxChart = new Chart(ctxLux, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Luminosidade (Lux)',
                    data: generateData(12, 100, 500),
                    borderColor: '#ffce56',
                    backgroundColor: 'rgba(255, 206, 86, 0.4)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'Variação de Luminosidade' }
                }
            }
        });

        // 3. Gráfico Comparativo (Barra)
        const ctxComp = document.getElementById('sensorComparisonChart').getContext('2d');
        const sensorComparisonChart = new Chart(ctxComp, {
            type: 'bar',
            data: {
                labels: ['DL-01', 'DL-02', 'DL-03'],
                datasets: [{
                    label: 'Temp Média Hoje',
                    data: [14.2, 15.1, 13.8],
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(75, 192, 192, 0.7)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'Comparativo entre Sensores' }
                }
            }
        });

        async function updateDashboard() {
            // Pega o device selecionado no dropdown
            const deviceId = document.getElementById('sensorSelect').value;
            const btn = document.querySelector('.btn-filter');
            btn.innerText = "Carregando...";

            try {
                // Chama nosso Controller C#
                const response = await fetch(`@Url.Action("ObterDadosDashboard", "Home")?deviceId=${deviceId}`);
                const data = await response.json();

                // 1. Atualiza KPI Cards
                const cards = document.querySelectorAll('.kpi-value');
                cards[0].innerText = data.kpi.temp.toFixed(1) + ' °C'; // Temperatura
                cards[1].innerText = data.kpi.hum.toFixed(1) + '%';    // Umidade
                cards[2].innerText = data.kpi.lum.toFixed(0) + ' Lux'; // Luminosidade

                // 2. Atualiza Gráfico Temp/Hum
                // Se o histórico vier vazio, mantemos arrays vazios para não quebrar
                tempHumidityChart.data.datasets[0].data = data.charts.temp || [];
                tempHumidityChart.data.datasets[1].data = data.charts.hum || [];

                // Ajusta labels dinamicamente se necessário (quantidade de pontos)
                // Aqui mantemos as labels fixas de hora por enquanto, mas idealmente viriam do backend
                tempHumidityChart.update();

                // 3. Atualiza Gráfico Lux
                luxChart.data.datasets[0].data = data.charts.lum || [];
                luxChart.update();

                console.log("Dados atualizados do FIWARE:", data);

            } catch (error) {
                console.error("Erro ao buscar dados:", error);
                alert("Erro ao conectar com o servidor.");
            } finally {
                btn.innerText = "Atualizar";
            }
        }

        // Carrega os dados assim que a página abre
        document.addEventListener("DOMContentLoaded", () => {
            updateDashboard();
        });

        async function updateDashboard() {
            // Pega o device selecionado no dropdown
            const deviceId = document.getElementById('sensorSelect').value;

            // Validação simples para não quebrar se não tiver sensor selecionado
            if (!deviceId) {
                console.warn("Nenhum dispositivo selecionado.");
                return;
            }

            const btn = document.querySelector('.btn-filter');
            btn.innerText = "Carregando...";

            try {
                // Chama nosso Controller C#
                // Note que aqui o deviceId virá do value do option (que é o ID do FIWARE ex: logger001)
                const response = await fetch(`@Url.Action("ObterDadosDashboard", "Home")?deviceId=${deviceId}`);

                if (!response.ok) throw new Error('Falha na requisição');

                const data = await response.json();

                // 1. Atualiza KPI Cards
                const cards = document.querySelectorAll('.kpi-value');
                // Verifica se os dados existem antes de tentar acessar
                if(data.kpi) {
                    cards[0].innerText = (data.kpi.temp || 0).toFixed(1) + ' °C';
                    cards[1].innerText = (data.kpi.hum || 0).toFixed(1) + '%';
                    cards[2].innerText = (data.kpi.lum || 0).toFixed(0) + ' Lux';
                }

                // 2. Atualiza Gráficos (verifica se charts existe)
                if(data.charts) {
                    tempHumidityChart.data.datasets[0].data = data.charts.temp || [];
                    tempHumidityChart.data.datasets[1].data = data.charts.hum || [];
                    tempHumidityChart.update();

                    luxChart.data.datasets[0].data = data.charts.lum || [];
                    luxChart.update();
                }

            } catch (error) {
                console.error("Erro ao buscar dados:", error);
                // Não alertar toda vez para não travar a tela do usuário em loops
            } finally {
                btn.innerText = "Atualizar";
            }
        }

        // Carrega os dados assim que a página abre
        document.addEventListener("DOMContentLoaded", () => {
            // Seleciona automaticamente o primeiro sensor da lista se houver
            const sensorSelect = document.getElementById('sensorSelect');
            if (sensorSelect.options.length > 0 && sensorSelect.value) {
                updateDashboard();
            }
        });

    </script>
</body>
</html>